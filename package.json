{
  "name": "pstack-workspace",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "test": "bun test",
    "check:boundaries": "bun scripts/check-boundaries.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "typescript": "~5.9.3"
  },
  "overrides": {
    "@niwa-labs/client": "link:../niwa/packages/client",
    "@niwa-labs/cockpit-sdk": "link:../niwa/packages/cockpit-sdk",
    "@niwa-labs/core": "link:../niwa/packages/core",
    "@niwa-labs/digest": "link:../niwa/packages/digest",
    "@niwa-labs/evidence": "link:../plugins/packages/evidence",
    "@niwa-labs/flow": "link:../niwa/packages/flow",
    "@niwa-labs/flow-code": "link:../niwa/packages/flow-code",
    "@niwa-labs/flow-eval": "link:../niwa/packages/flow-eval",
    "@niwa-labs/forge": "link:../plugins/packages/forge",
    "@niwa-labs/git": "link:../niwa/packages/git",
    "@niwa-labs/harness": "link:../niwa/packages/harness",
    "@niwa-labs/history": "link:../niwa/packages/history",
    "@niwa-labs/host": "link:../niwa/packages/host",
    "@niwa-labs/messages": "link:../niwa/packages/messages",
    "@niwa-labs/plan": "link:../plugins/packages/plan",
    "@niwa-labs/plugin": "link:../niwa/packages/plugin",
