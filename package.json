{
  "name": "pstack-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "test": "bun test",
    "check:boundaries": "bun scripts/check-boundaries.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "typescript": "~5.9.3"
  },
  "overrides": {
