    "@niwa-labs/script": "link:../niwa/packages/script",
    "@niwa-labs/sessions": "link:../niwa/packages/sessions",
    "@niwa-labs/tasks": "link:../niwa/packages/tasks",
    "@niwa-labs/testing": "link:../niwa/packages/testing",
    "@niwa-labs/timer": "link:../niwa/packages/timer",
    "@niwa-labs/ui-kit": "link:../niwa/packages/ui-kit",
    "@niwa-labs/upstream-map": "link:../niwa/packages/upstream-map",
